# RxCheck API Keys (Get free key at https://rxcheck.dev)
# Primary API key:
VITE_RXCHECK_API_KEY=your_rxcheck_api_key_here

# Multiple fallback API keys (comma-separated):
# The app will automatically rotate to the next key when queries_remaining reaches 0 or returns 429
VITE_RXCHECK_API_KEYS=key_1,key_2,key_3

# RxCheck Base API URL:
VITE_RXCHECK_BASE_URL=https://api.rxcheck.dev/v1
